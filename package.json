{
  "name": "openkanban",
  "version": "1.0.0",
  "private": true,
  "description": "A kanban board with dependencies. Static export, no server, no accounts.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "dev": "next dev",
    "build": "next build",
    "check": "node tests/check-syntax.mjs && node tests/check-styles.mjs",
    "test": "node tests/smoke.mjs",
    "behaviour": "node tests/run-behaviour.mjs --target vanilla",
    "behaviour:next": "node tests/run-behaviour.mjs --target react --mode report",
    "behaviour:next:gate": "node tests/run-behaviour.mjs --target react",
    "behaviour:reference": "node tests/run-behaviour.mjs --target vanilla",
    "behaviour:both": "node tests/run-behaviour.mjs --target both --mode report",
    "behaviour:all": "node tests/run-behaviour.mjs --target both --mode report",
    "compare": "node tests/run-behaviour.mjs --compare",
    "lib:test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
